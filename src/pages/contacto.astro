---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Contacto"
  descripcion="Contacto y información sobre la Calculadora de Insumos: preguntas, sugerencias o reportes de problemas."
  rutaActual="/contacto/"
  conAnuncio={false}
>
  <header>
    <h1>Contacto</h1>
    <p class="subtitulo">
      Preguntas, sugerencias o reportes de problemas
    </p>
  </header>

  <section class="ayuda">
    <h2>Escríbenos</h2>
    <p>
      Correo:
      <a href="mailto:contacto@calculadorainsumos.com">contacto@calculadorainsumos.com</a>
    </p>
    <p>
      Si prefieres, puedes escribir a
      <a href="mailto:info@calculadorainsumos.com">info@calculadorainsumos.com</a>.
      Ambas direcciones llegan al mismo lugar.
    </p>
  </section>

  <section class="ayuda">
    <h2>Sobre esta herramienta</h2>
    <p>
      La Calculadora de Insumos es una herramienta de apoyo para
      caficultores, técnicos y cualquier otra persona relacionada con el
      agro, incluso con otras áreas donde se necesiten mezclas de insumos.
      No reemplaza la asesoría de un agrónomo: la dosis correcta depende del
      análisis de suelo, la variedad, la edad del cultivo y el historial de
      fertilización.
    </p>
    <p>
      El código es abierto y puedes consultarlo en
      <a href="https://github.com/CAgudeloBetancur/calculadora-insumos" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>.
    </p>
  </section>

  <section class="ayuda">
    <h2>Herramientas del sitio</h2>
    <ul>
      <li><a href="/">Calculadora de bultos de fertilizante</a></li>
      <li><a href="/densidad/">Calculadora de densidad de siembra</a></li>
      <li><a href="/conversion/">Convertidor de unidades del agro</a></li>
      <li><a href="/glosario/">Glosario de insumos del café</a></li>
      <li><a href="/preguntas-frecuentes/">Preguntas frecuentes</a></li>
    </ul>
  </section>

  <p><a href="/">← Volver a la calculadora</a></p>
</Base>
