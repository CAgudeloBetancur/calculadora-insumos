---
import Base from '../layouts/Base.astro';
import { Calculadora } from '../components/Calculadora';
---

<Base
  titulo="Calculadora de insumos"
  descripcion="Calcula cuántos bultos de fertilizante necesitas para tu cultivo, con la dosis por planta y la proporción de la mezcla. Funciona sin internet y no requiere registro."
  rutaActual="/"
  conAnuncio={false}
>
  <header>
    <h1>Calculadora de Insumos</h1>
    <p class="subtitulo">
      ¿Cuántos bultos de insumos necesitas para tu cultivo?
    </p>
  </header>

  <Calculadora client:load />

  <nav class="enlaces-relacionados" aria-label="Otras herramientas">
    <h2>Otras herramientas</h2>
    <ul>
      <li>
        <a href="/densidad/">Calculadora de densidad de siembra</a>
        <p>
          ¿Cuántas plantas caben en tu finca? O, al revés, ¿qué extensión
          necesitas para sembrar cierta cantidad de árboles?
        </p>
      </li>
      <li>
        <a href="/conversion/">Convertidor de unidades del agro</a>
        <p>
          Quintales, arrobas, cargas, libras, bultos y más.
        </p>
      </li>
      <li>
        <a href="/glosario/">Glosario de insumos del café</a>
        <p>Qué es cada producto y para qué se usa.</p>
      </li>
      <li>
        <a href="/preguntas-frecuentes/">Preguntas frecuentes</a>
        <p>Las dudas que más recibimos.</p>
      </li>
    </ul>
  </nav>
</Base>
