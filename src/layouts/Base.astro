---
import Navegacion from '../components/Navegacion.astro';
import PieDePagina from '../components/PieDePagina.astro';
import { SITIO } from '../config';
import '../styles/global.css';

interface Props {
  /** Título de la página (sin el nombre del sitio). */
  titulo: string;
  /** Meta description. */
  descripcion: string;
  /** Ruta actual, para resaltar el enlace activo del nav. */
  rutaActual?: string;
  /** Si es false, no carga el script de AdSense. */
  conAnuncio?: boolean;
}

const {
  titulo,
  descripcion,
  rutaActual = '/',
  conAnuncio = true,
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2f6b45" />
    <meta name="description" content={descripcion} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Calculadora" />

    {
      conAnuncio && (
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5894289566118949"
          crossorigin="anonymous"
        />
      )
    }

    <title>{titulo} | {SITIO.nombre}</title>
  </head>

  <body>
    <div class="barra-navegacion">
      <div class="contenedor">
        <Navegacion rutaActual={rutaActual} />
      </div>
    </div>

    <main class="contenedor">
      <slot />
    </main>

    <div class="pie-fondo">
      <PieDePagina />
    </div>

    <script>
      import { registrarServiceWorker } from '../scripts/register-sw';
      registrarServiceWorker();
    </script>
  </body>
</html>
